# {{ ansible_managed }}

[Unit]
Description=rtpengine
After=network.target
Documentation=https://www.rtpengine.org

[Service]
# RTPEngine runs in the foreground (--foreground), so the process that systemd
# starts is the service, and it reports READY=1 when it accepts ng commands.
# systemd needs no PID file, and stops RTPEngine with SIGTERM.
# Without --foreground, RTPEngine forks, and its parent can exit before the
# child writes the PID file: systemd then stops the new RTPEngine right after
# its startup.
Type=notify

Restart=always
RestartSec=5s

LimitNOFILE={{ rtpengine_nofile_limit }}

User={{ rtpengine_user }}
Group={{ rtpengine_group }}

ExecStart={{ rtpengine_install_dir }}/usr/bin/rtpengine \
    --foreground \
    --listen-{{ rtpengine_ctrl_protocol }}={{ rtpengine_addr }}:{{ rtpengine_ctrl_port }} \
    --interface={{ rtpengine_addr }}{{ "!" + rtpengine_advaddr if rtpengine_advaddr else "" }} \
    --port-min={{ rtpengine_min_port }} --port-max={{ rtpengine_max_port }} \
    --log-level={{ rtpengine_log_level }} \
    --log-facility={{ rtpengine_syslog_facility }} \
    --tos={{ rtpengine_tos }} \
{% if rtpengine_timeout %}
    --timeout={{ rtpengine_timeout }} \
{% endif %}
{% if rtpengine_silent_timeout %}
    --silent-timeout={{ rtpengine_silent_timeout }} \
{% endif %}
{% if rtpengine_final_timeout %}
    --final-timeout={{ rtpengine_final_timeout }} \
{% endif %}
    {{ "--nftables-chain=" + rtpengine_nft_table if rtpengine_use_kernel_module and rtpengine_nft_table else "" }}{{ "--config-file=" + rtpengine_config_file if rtpengine_config_file else "" }}


TimeoutStartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target